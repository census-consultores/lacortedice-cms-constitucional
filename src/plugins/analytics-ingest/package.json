{
  "version": "1.0.0",
  "keywords": ["analytics", "tracking", "traceability"],
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "verify": "strapi-plugin verify",
    "test:ts:back": "run -T tsc -p server/tsconfig.json"
  },
  "devDependencies": {
    "@strapi/sdk-plugin": "^5.3.2",
    "@strapi/typescript-utils": "^5.12.4"
  },
  "peerDependencies": {
    "@strapi/strapi": "^5.31.0",
    "typescript": "^5"
  },
  "strapi": {
    "kind": "plugin",
    "name": "analytics-ingest",
    "displayName": "Analytics Ingest",
    "description": "Sistema de trazabilidad profunda · ingesta de eventos y API analítica"
  },
  "name": "analytics-ingest",
  "description": "Event ingestion + analytics admin API for La Corte Dice Tributaria",
  "license": "MIT",
  "author": "Census Consultores"
}
