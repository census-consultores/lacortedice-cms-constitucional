{
  "kind": "collectionType",
  "collectionName": "eventos",
  "info": {
    "singularName": "evento",
    "pluralName": "eventos",
    "displayName": "Evento",
    "description": "Publicaciones tipo evento (congresos, seminarios, etc.) que se muestran en la landing page pública."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "titulo": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "titulo",
      "required": true
    },
    "extracto": {
      "type": "text",
      "required": true,
      "maxLength": 280
    },
    "contenido": {
      "type": "richtext"
    },
    "foto": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "fecha": {
      "type": "date",
      "required": true
    },
    "mostrar_solo_ano": {
      "type": "boolean",
      "default": false
    },
    "etiquetas": {
      "type": "json"
    },
    "creado_por": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "actualizado_por": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    }
  }
}
